                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('Error message exists', () => pm.expect(pm.response.json().message).to.exist);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
