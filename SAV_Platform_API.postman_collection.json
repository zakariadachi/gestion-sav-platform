    },

    {
      "name": "🎫 Tickets",
      "description": "CRUD complet pour les tickets. Le comportement varie selon le rôle :\n- **Admin** : voit tous les tickets, peut assigner\n- **Technicien** : voit ses tickets assignés, peut changer le statut\n- **Client** : voit uniquement ses propres tickets, peut créer",
      "item": [

        {
          "name": "GET /tickets – Admin (tous les tickets)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Data array exists', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data).to.be.an('array');",
                  "});",
                  "if (pm.response.json().data.length > 0) {",
                  "    pm.collectionVariables.set('ticket_id', pm.response.json().data[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept",        "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "url": {
              "raw": "{{base_url}}/tickets?page=1",
              "host": ["{{base_url}}"],
              "path": ["tickets"],
              "query": [{ "key": "page", "value": "1" }]
            },
            "description": "Liste paginée (15/page). Résultats filtrés selon le rôle de l'utilisateur."
          }
        },

        {
          "name": "GET /tickets – Client (ses tickets)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Data array exists', () => pm.expect(pm.response.json().data).to.be.an('array'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept",        "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_client}}" }
            ],
            "url": { "raw": "{{base_url}}/tickets", "host": ["{{base_url}}"], "path": ["tickets"] }
          }
        },

        {
          "name": "GET /tickets – Technicien (ses tickets assignés)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept",        "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_tech}}" }
            ],
            "url": { "raw": "{{base_url}}/tickets", "host": ["{{base_url}}"], "path": ["tickets"] }
          }
        },

        {
          "name": "POST /tickets – Créer un ticket (Client)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Ticket has id', () => pm.expect(json.data.id).to.exist);",
                  "pm.test('Statut is Nouveau', () => pm.expect(json.data.statut).to.eql('Nouveau'));",
                  "pm.collectionVariables.set('ticket_id', json.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept",        "value": "application/json" },
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_client}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titre\": \"Imprimante réseau hors service\",\n  \"description\": \"L'imprimante du bureau 304 ne répond plus depuis ce matin. Impossible d'imprimer depuis n'importe quel poste du réseau.\",\n  \"priorite\": \"Haute\"\n}"
            },
            "url": { "raw": "{{base_url}}/tickets", "host": ["{{base_url}}"], "path": ["tickets"] },
            "description": "Seuls les **Clients** peuvent créer des tickets. L'id du ticket est sauvegardé dans `ticket_id`."
          }
        },

        {
          "name": "POST /tickets – Priorité Critique",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Priorite is Critique', () => pm.expect(pm.response.json().data.priorite).to.eql('Critique'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept",        "value": "application/json" },
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_client}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titre\": \"Serveur principal inaccessible\",\n  \"description\": \"Le serveur de fichiers principal est tombé. Tous les utilisateurs sont bloqués. Intervention urgente requise.\",\n  \"priorite\": \"Critique\"\n}"
            },
            "url": { "raw": "{{base_url}}/tickets", "host": ["{{base_url}}"], "path": ["tickets"] }
          }
        },

        {
          "name": "❌ POST /tickets – Accès refusé (Admin tente de créer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 403', () => pm.response.to.have.status(403));",
                  "pm.test('Error message', () => pm.expect(pm.response.json().message).to.exist);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept",        "value": "application/json" },
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titre\": \"Test interdit\",\n  \"description\": \"Un admin ne doit pas pouvoir créer de ticket.\",\n  \"priorite\": \"Basse\"\n}"
            },
            "url": { "raw": "{{base_url}}/tickets", "host": ["{{base_url}}"], "path": ["tickets"] }
          }
        },

        {
          "name": "GET /tickets/{id} – Détail d'un ticket",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has titre', () => pm.expect(pm.response.json().data.titre).to.exist);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept",        "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "url": { "raw": "{{base_url}}/tickets/{{ticket_id}}", "host": ["{{base_url}}"], "path": ["tickets", "{{ticket_id}}"] },
            "description": "Remplacez `{{ticket_id}}` par un ID réel ou utilisez la variable."
          }
        },

        {
          "name": "❌ GET /tickets/{id} – Ticket non autorisé (Client → ticket d'autrui)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 403 or 404', () => {",
                  "    pm.expect([403, 404]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept",        "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_client}}" }
            ],
            "url": { "raw": "{{base_url}}/tickets/9999", "host": ["{{base_url}}"], "path": ["tickets", "9999"] },
            "description": "Ticket inexistant ou appartenant à un autre client → 403 ou 404."
          }
        },

        {
          "name": "PATCH /tickets/{id}/assign – Assigner un technicien (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Statut is En cours', () => pm.expect(pm.response.json().data.statut).to.eql('En cours'));",
                  "pm.test('Technicien assigned', () => pm.expect(pm.response.json().data.technicien).to.exist);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept",        "value": "application/json" },
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"technicien_id\": {{technicien_id}}\n}"
            },
            "url": { "raw": "{{base_url}}/tickets/{{ticket_id}}/assign", "host": ["{{base_url}}"], "path": ["tickets", "{{ticket_id}}", "assign"] },
            "description": "L'Admin assigne un technicien. Le statut passe automatiquement à **En cours**."
          }
        },

        {
          "name": "❌ PATCH /tickets/{id}/assign – Refusé (non Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 403', () => pm.response.to.have.status(403));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept",        "value": "application/json" },
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_client}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"technicien_id\": {{technicien_id}}\n}"
            },
            "url": { "raw": "{{base_url}}/tickets/{{ticket_id}}/assign", "host": ["{{base_url}}"], "path": ["tickets", "{{ticket_id}}", "assign"] }
          }
        },

        {
          "name": "PATCH /tickets/{id}/status – Changer statut (Technicien)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Statut updated', () => {",
                  "    const s = pm.response.json().data.statut;",
                  "    pm.expect(['En cours', 'Résolu']).to.include(s);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept",        "value": "application/json" },
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_tech}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"statut\": \"Résolu\"\n}"
            },
            "url": { "raw": "{{base_url}}/tickets/{{ticket_id}}/status", "host": ["{{base_url}}"], "path": ["tickets", "{{ticket_id}}", "status"] },
            "description": "Valeurs acceptées pour `statut` : `En cours`, `Résolu`. Seul le technicien **assigné** peut modifier."
          }
        },

        {
          "name": "❌ PATCH /tickets/{id}/status – Refusé (Client tente de changer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 403', () => pm.response.to.have.status(403));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept",        "value": "application/json" },
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_client}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"statut\": \"Résolu\"\n}"
            },
            "url": { "raw": "{{base_url}}/tickets/{{ticket_id}}/status", "host": ["{{base_url}}"], "path": ["tickets", "{{ticket_id}}", "status"] }
          }
        }

      ]
    },

    {
      "name": "📋 Rapports d'Intervention",
      "description": "Les rapports sont créés par les techniciens après résolution d'un ticket. La création d'un rapport passe automatiquement le ticket en statut **Résolu**.",
      "item": [

        {
          "name": "POST /tickets/{id}/rapport – Créer un rapport (Technicien)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
