    {
      "name": "⚡ Workflow Complet (Scénario E2E)",
      "description": "Scénario de bout en bout pour tester le flux complet :\n1. Client crée un ticket\n2. Admin assigne un technicien\n3. Technicien soumet un rapport\n4. Client consulte le rapport\n\nExécuter ces requêtes **dans l'ordre** après avoir configuré les tokens.",
      "item": [

        {
          "name": "Étape 1 – Client crée un ticket",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Ticket créé (201)', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('ticket_id', pm.response.json().data.id);",
                  "console.log('✅ ticket_id =', pm.response.json().data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept",        "value": "application/json" },
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_client}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titre\": \"[E2E] VPN impossible à connecter\",\n  \"description\": \"Depuis la mise à jour Windows du 12/06, le client VPN refuse toutes les connexions avec l'erreur code 800. Besoin d'une intervention urgente.\",\n  \"priorite\": \"Haute\"\n}"
            },
            "url": { "raw": "{{base_url}}/tickets", "host": ["{{base_url}}"], "path": ["tickets"] }
          }
        },

        {
          "name": "Étape 2 – Admin assigne le technicien",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Assignation réussie (200)', () => pm.response.to.have.status(200));",
                  "pm.test('Statut = En cours', () => pm.expect(pm.response.json().data.statut).to.eql('En cours'));",
                  "console.log('✅ Technicien assigné');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept",        "value": "application/json" },
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"technicien_id\": {{technicien_id}}\n}"
            },
            "url": { "raw": "{{base_url}}/tickets/{{ticket_id}}/assign", "host": ["{{base_url}}"], "path": ["tickets", "{{ticket_id}}", "assign"] }
          }
        },

        {
          "name": "Étape 3 – Technicien soumet le rapport",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Rapport créé (201)', () => pm.response.to.have.status(201));",
                  "console.log('✅ Rapport soumis, ticket passé à Résolu');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept",        "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_tech}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "contenu",
                  "value": "[E2E] Problème VPN résolu après désinstallation et réinstallation du client Cisco AnyConnect v4.10. Mise à jour du certificat d'authentification. Test de connexion validé depuis le poste du client.",
                  "type": "text"
                }
              ]
            },
            "url": { "raw": "{{base_url}}/tickets/{{ticket_id}}/rapport", "host": ["{{base_url}}"], "path": ["tickets", "{{ticket_id}}", "rapport"] }
          }
        },

        {
          "name": "Étape 4 – Client consulte le rapport final",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Rapport accessible (200)', () => pm.response.to.have.status(200));",
                  "pm.test('Contenu existe', () => pm.expect(pm.response.json().data.contenu).to.exist);",
                  "console.log('✅ Workflow E2E complet !');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept",        "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_client}}" }
            ],
            "url": { "raw": "{{base_url}}/tickets/{{ticket_id}}/rapport", "host": ["{{base_url}}"], "path": ["tickets", "{{ticket_id}}", "rapport"] }
          }
        },

